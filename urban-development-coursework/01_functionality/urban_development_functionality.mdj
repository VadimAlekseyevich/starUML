				{
					"_type": "UMLActivity",
					"_id": "ALG2_DataManagement_Activity",
					"_parent": {
						"$ref": "Hoqr3g8miEazkyw1ankPKwAA"
					},
					"name": "DataManagement",
					"documentation": "Алгоритм реализации варианта использования «Управление исходными геоданными». Главная диаграмма маршрутизирует операции; сложные процедуры импорта и контроля качества вынесены в DatasetImport и DataQualityValidation, как отдельные вызываемые деятельности.",
					"tags": [
						{
							"_type": "Tag",
							"_id": "ALG2_DataManagement_Tag_realizesUseCase",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "realizesUseCase",
							"kind": "string",
							"value": "1jOxeC6gjkO+wWcBsjd+rQAA"
						}
					],
					"nodes": [
						{
							"_type": "UMLInitialNode",
							"_id": "ALG2_DataManagement_Node_start",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Начало",
							"documentation": "Начальная точка алгоритма «DataManagement». Управление передаётся первому действию без guard и effect."
						},
						{
							"_type": "UMLDecisionNode",
							"_id": "ALG2_DataManagement_Node_opDecision",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Выбранная операция",
							"documentation": "Узел решения проверяет условия исходящих переходов: [выбран импорт], [выбран просмотр], [выбрана проверка качества], [требуется интерпретация слоя], [else]. Ровно один допустимый поток продолжает выполнение; [else] используется как резервная ветвь."
						},
						{
							"_type": "UMLMergeNode",
							"_id": "ALG2_DataManagement_Node_merge",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Операция завершена",
							"documentation": "Технический узел слияния объединяет альтернативные потоки без принятия нового решения. Он обеспечивает один вход в следующий Action, как требует методика."
						},
						{
							"_type": "UMLActivityFinalNode",
							"_id": "ALG2_DataManagement_Node_end",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Завершение",
							"documentation": "Конечная точка алгоритма «DataManagement». Достижение узла завершает текущую деятельность."
						},
						{
							"_type": "UMLMergeNode",
							"_id": "ALG2_DataManagement_Node_chooseMerge",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Слить поток выбора операции",
							"documentation": "Технический узел слияния объединяет альтернативные потоки без принятия нового решения. Он обеспечивает один вход в следующий Action, как требует методика."
						}
					],
					"edges": [
						{
							"_type": "UMLControlFlow",
							"_id": "ALG2_DataManagement_Flow_e1",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"source": {
								"$ref": "ALG2_DataManagement_Node_start"
							},
							"target": {
								"$ref": "ALG2_DataManagement_Node_open"
							},
							"documentation": "Безусловный переход от «Начало» к «Открыть исходные геоданные» выполняется по завершении исходного узла. Дополнительные trigger, guard и effect отсутствуют."
						},
						{
							"_type": "UMLControlFlow",
							"_id": "ALG2_DataManagement_Flow_e2",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"source": {
								"$ref": "ALG2_DataManagement_Node_open"
							},
							"target": {
