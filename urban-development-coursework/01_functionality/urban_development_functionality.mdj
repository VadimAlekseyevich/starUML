								"$ref": "ALG2_ResultExport_Node_receive"
							},
							"target": {
								"$ref": "ALG2_ResultExport_Node_end"
							},
							"documentation": "Безусловный переход от «Получить сформированный пакет» к «Завершение» выполняется по завершении исходного узла. Дополнительные trigger, guard и effect отсутствуют."
						}
					],
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ResultExport_Partition_user",
							"_parent": {
								"$ref": "ALG2_ResultExport_Activity"
							},
							"name": "Пользователь",
							"documentation": "Swimlane «Пользователь»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_select",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_user"
									},
									"name": "Выбрать сценарий и команду экспорта",
									"documentation": "Пользователь выбирает завершённый сценарий и запускает экспорт. Незавершённые/ошибочные Run не предлагаются как источник обычного экспорта."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_choose",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_user"
									},
									"name": "Выбрать формат и состав экспорта",
									"documentation": "Пользователь выбирает формат и состав пакета: пространственные слои, метрики и manifest либо допустимое подмножество."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_receive",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_user"
									},
									"name": "Получить сформированный пакет",
									"documentation": "Пользователь инициирует получение готового файла/архива; чтение результата не изменяет данные сценария."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ResultExport_Partition_system",
							"_parent": {
								"$ref": "ALG2_ResultExport_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_formats",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Показать поддерживаемые форматы",
									"documentation": "Система определяет допустимые форматы с учётом доступных геослоёв и метрик и показывает краткое описание ограничений каждого формата."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_compat",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Проверить совместимость формата с данными",
									"documentation": "Система проверяет, поддерживает ли выбранный формат типы геометрии, систему координат, атрибуты и объём выбранных данных."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_limit",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Сообщить об ограничении формата",
									"documentation": "Система объясняет несовместимость и предлагает другой формат либо корректное подмножество данных, не начиная формирование артефакта."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_collect",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Собрать пространственные слои, метрики и manifest",
									"documentation": "Система фиксирует состав экспорта и собирает опубликованные слои, метрики, manifest и необходимые метаданные одного Run."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_convert",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Преобразовать данные в выбранный формат",
									"documentation": "Система преобразует данные в выбранный формат, сохраняя CRS/единицы и сопоставимость атрибутов; ошибки конвертации передаются следующему контролю результата."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_package",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Сформировать итоговый артефакт экспорта",
									"documentation": "Система формирует целевой файл или архив, вычисляет итоговые метаданные и размещает артефакт в хранилище экспорта."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_diag",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Сохранить диагностику и сообщить об ошибке",
									"documentation": "Система сохраняет этап, код и сообщение ошибки формирования/записи и сообщает пользователю, что пакет не готов."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ResultExport_Node_ready",
									"_parent": {
										"$ref": "ALG2_ResultExport_Partition_system"
									},
									"name": "Сообщить о готовности пакета",
									"documentation": "Система регистрирует готовый артефакт и предоставляет пользователю имя, формат, размер и действие получения."
								}
							]
						}
