							"documentation": "Swimlane «Пользователь»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_init",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_user"
									},
									"name": "Инициировать создание проекта",
									"documentation": "Пользователь выбирает команду создания нового проекта. До успешной проверки параметров постоянные данные проекта не создаются."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_bounds",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_user"
									},
									"name": "Задать название и границы проекта",
									"documentation": "Пользователь вводит непустое имя и задаёт полигон территории на карте либо координатами. Значения передаются в проверку без сохранения."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_fixBounds",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_user"
									},
									"name": "Исправить границы",
									"documentation": "Пользователь корректирует имя или геометрию территории по диагностике системы и повторно отправляет форму на проверку."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_chooseCrs",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_user"
									},
									"name": "Выбрать рабочую систему координат",
									"documentation": "Пользователь принимает предложенную CRS либо выбирает другую из поддерживаемого списка."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ProjectCreation_Partition_system",
							"_parent": {
								"$ref": "ALG2_ProjectCreation_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_request",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Запросить название и границы проекта",
									"documentation": "Система открывает форму создания проекта с полями имени, геометрии территории и рабочей системы координат; отображаются допустимые значения и подсказки."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_checkBounds",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Проверить геометрию границ",
									"documentation": "Система проверяет наличие и валидность геометрии: ненулевую площадь, отсутствие самопересечений и возможность пространственных операций в выбранном контексте."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_boundsError",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Сообщить об ошибке геометрии",
									"documentation": "Система показывает конкретную причину ошибки геометрии и сохраняет введённые значения в форме, чтобы пользователь мог исправить только проблемные данные."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_offerCrs",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Предложить рабочую систему координат",
									"documentation": "Система определяет подходящую рабочую CRS по территории и доступным геоданным и показывает её код/название как рекомендуемый вариант."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_checkCrs",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Проверить поддержку CRS",
									"documentation": "Система проверяет распознавание CRS и наличие необходимых преобразований координат для территории и подключаемых наборов данных."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_crsError",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Сообщить о неподдерживаемой CRS",
									"documentation": "Система отклоняет неподдерживаемую CRS, показывает причину и список допустимых вариантов без потери остальных параметров проекта."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_save",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Сохранить проект",
									"documentation": "Система атомарно сохраняет идентификатор проекта, имя, границы и рабочую CRS; незавершённый объект не должен остаться при ошибке записи."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ProjectCreation_Node_open",
									"_parent": {
										"$ref": "ALG2_ProjectCreation_Partition_system"
									},
									"name": "Открыть созданный проект",
									"documentation": "Система делает созданный проект текущим, загружает его рабочий контекст и открывает основной интерфейс дальнейшей работы."
								}
							]
						}
