					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioComparison_Partition_user",
							"_parent": {
								"$ref": "ALG2_ScenarioComparison_Activity"
							},
							"name": "Пользователь / ГИС-аналитик",
							"documentation": "Swimlane «Пользователь / ГИС-аналитик»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_open",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_user"
									},
									"name": "Открыть результаты проекта",
									"documentation": "Пользователь открывает раздел результатов текущего проекта. Система ограничивает выбор запусками, имеющими опубликованные метрики/артефакты."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_select",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_user"
									},
									"name": "Выбрать сценарии для сравнения",
									"documentation": "Пользователь выбирает один сценарий для просмотра либо несколько совместимых сценариев для сравнения."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_metrics",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_user"
									},
									"name": "Выбрать набор метрик",
									"documentation": "Пользователь выбирает набор показателей (например, плотность, освоение, связность, инфраструктура, нарушения); система проверяет, что метрики доступны у выбранных запусков."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_analyze",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_user"
									},
									"name": "Проанализировать различия сценариев",
									"documentation": "Пользователь интерпретирует различия карт и метрик; это аналитическое действие не изменяет результаты запусков."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioComparison_Partition_system",
							"_parent": {
								"$ref": "ALG2_ScenarioComparison_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_load",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Загрузить результаты завершённых сценариев",
									"documentation": "Система загружает метаданные завершённых запусков, manifest, итоговые метрики и ссылки на пространственные слои; тяжёлые слои могут подгружаться лениво."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_exclude",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Исключить недоступный результат и пояснить причину",
									"documentation": "Система исключает отсутствующий, повреждённый или незавершённый результат из доступного сравнения и показывает конкретную причину исключения."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_compose",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Сформировать сравнительное представление",
									"documentation": "Система связывает выбранные сценарии, метрики и геослои в единое сравнительное представление с согласованной легендой и масштабом."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_details",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Показать параметры, слои, метрики и нарушения",
									"documentation": "Система показывает параметры конфигурации, версии исходных данных, итоговые слои, метрики и зарегистрированные нарушения выбранного запуска."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_chart",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Визуализировать метрики сценариев",
									"documentation": "Система строит сравнимые графики/таблицы по выбранным метрикам, сохраняя одинаковые единицы измерения и порядок сценариев."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioComparison_Node_log",
									"_parent": {
										"$ref": "ALG2_ScenarioComparison_Partition_system"
									},
									"name": "Показать журнал выполнения этапов",
									"documentation": "Система показывает журнал этапов генерации с состоянием, временем и диагностикой каждого этапа без раскрытия внутренних служебных данных, не нужных пользователю."
								}
							]
						}
					],
