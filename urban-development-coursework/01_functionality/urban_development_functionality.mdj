								"$ref": "ALG2_ResultExport_Node_receive"
							},
							"documentation": "Безусловный переход от «Сообщить о готовности пакета» к «Получить сформированный пакет» выполняется по завершении исходного узла. Дополнительные trigger, guard и effect отсутствуют."
						},
						{
							"_type": "UMLControlFlow",
							"_id": "ALG2_ResultExport_Flow_e17",
							"_parent": {
								"$ref": "ALG2_ResultExport_Activity"
							},
