							"documentation": "Безусловный переход от «Сохранить валидную конфигурацию» к «Завершение» выполняется по завершении исходного узла. Дополнительные trigger, guard и effect отсутствуют."
						}
					],
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioConfiguration_Partition_user",
							"_parent": {
								"$ref": "ALG2_ScenarioConfiguration_Activity"
							},
							"name": "Пользователь / ГИС-аналитик",
							"documentation": "Swimlane «Пользователь / ГИС-аналитик»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_open",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Создать или открыть конфигурацию",
									"documentation": "Пользователь создаёт новую конфигурацию сценария либо открывает существующую. Система загружает текущие значения и версию исходных данных."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_mode",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Выбрать режим генерации",
									"documentation": "Пользователь выбирает режим: расширение существующей территории или генерация с нуля. Выбор определяет обязательность исходной территории и набор допустимых параметров."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_seed",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Указать seed генерации",
									"documentation": "Пользователь задаёт или принимает сгенерированный seed. Система хранит его как часть конфигурации для воспроизводимости результата."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_build",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Задать параметры застройки",
									"documentation": "Пользователь задаёт параметры застройки (например, диапазоны плотности/этажности и ограничения размещения) через поля формы; значения пока не считаются валидными."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_infra",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Задать параметры инфраструктуры",
									"documentation": "Пользователь задаёт параметры инфраструктуры и обеспеченности объектами; система сохраняет значения в черновике конфигурации."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_territory",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Выбрать исходную территорию",
									"documentation": "Для режима расширения пользователь выбирает исходную территорию/снимок и связанные наборы данных, которые будут зафиксированы в запуске."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_fix",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_user"
									},
									"name": "Исправить параметры сценария",
									"documentation": "Пользователь исправляет только отмеченные параметры, после чего та же конфигурация повторно проходит общую валидацию."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioConfiguration_Partition_system",
							"_parent": {
								"$ref": "ALG2_ScenarioConfiguration_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "ALG2_ScenarioConfiguration_Node_validate",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_system"
									},
									"name": "Проверить конфигурацию сценария",
									"documentation": "Вызов переиспользуемой деятельности ScenarioValidation. Она проверяет обязательные параметры, диапазоны, совместимость режима, исходной территории и готовность геоданных.",
									"behavior": {
										"$ref": "ALG2_ScenarioValidation_Activity"
									},
									"isSynchronous": true
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_errors",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_system"
									},
									"name": "Показать ошибки конфигурации",
									"documentation": "Система выводит список ошибок с привязкой к конкретным полям/данным и не сохраняет конфигурацию как готовую к запуску."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioConfiguration_Node_save",
									"_parent": {
										"$ref": "ALG2_ScenarioConfiguration_Partition_system"
									},
									"name": "Сохранить валидную конфигурацию",
									"documentation": "Система сохраняет валидную конфигурацию, seed, режим, параметры и ссылки на версии исходных данных; конфигурации присваивается статус готовности к запуску."
								}
							]
						}
