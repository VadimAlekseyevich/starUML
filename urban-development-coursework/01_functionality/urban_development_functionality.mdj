					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_GenerationExecution_Partition_system",
							"_parent": {
								"$ref": "ALG2_GenerationExecution_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_snapshot",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_system"
									},
									"name": "prepare_snapshot",
									"documentation": "Система фиксирует неизменяемый snapshot конфигурации, seed и версий исходных данных и создаёт RunContext. Все последующие этапы читают именно этот snapshot."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_record",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_system"
									},
									"name": "Зафиксировать нарушения в ValidationReport",
									"documentation": "Система добавляет обнаруженные некритические нарушения и предупреждения в ValidationReport с кодом, геометрией/объектом и этапом возникновения."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_failed",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_system"
									},
									"name": "Сохранить диагностику и установить failed",
									"documentation": "Система прекращает публикацию результата, фиксирует Failed и сохраняет диагностику критического этапа. Частичные артефакты остаются только как технические данные."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_cancelled",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_system"
									},
									"name": "Завершить в безопасной точке и установить cancelled",
									"documentation": "Система завершает выполнение в безопасной точке, фиксирует Cancelled и не публикует частичный результат как завершённый сценарий."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_completed",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_system"
									},
									"name": "Установить состояние completed",
									"documentation": "Система атомарно фиксирует Completed и публикует manifest, метрики и итоговые артефакты для последующего сравнения/экспорта."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_GenerationExecution_Partition_worker",
							"_parent": {
								"$ref": "ALG2_GenerationExecution_Activity"
							},
							"name": "Worker генерации",
							"documentation": "Swimlane «Worker генерации»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_constraints",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "evaluate_constraints",
									"documentation": "Worker вычисляет ограничения территории (запретные зоны, границы, существующие объекты и иные правила) и помещает нормализованный набор ограничений в RunContext."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_suitability",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "suitability",
									"documentation": "Worker рассчитывает карту/оценку пригодности территории из ограничений и исходных факторов; результат используется зонированием и сохраняется как промежуточный слой."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_zoning",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "zoning",
									"documentation": "Worker формирует функциональное зонирование с учётом пригодности, режима сценария и ограничений, записывая зоны в рабочий контекст."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_roads",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "roads",
									"documentation": "Worker строит связный дорожный каркас и проверяет его базовую геометрическую корректность перед передачей на этап кварталов."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_blocks",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "blocks_and_parcels",
									"documentation": "Worker делит территорию дорожной сетью на кварталы и участки, отбрасывая/помечая геометрически недопустимые элементы."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_buildings",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "buildings",
									"documentation": "Worker размещает здания на участках согласно параметрам застройки, ограничениям и seed; результат должен оставаться воспроизводимым."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_demography",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "demography",
									"documentation": "Worker рассчитывает население/ёмкость по созданной застройке и установленным нормативам и записывает агрегаты в RunContext."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_infra",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "infrastructure",
									"documentation": "Worker размещает/оценивает инфраструктуру и обеспеченность с учётом населения, доступности и ограничений территории."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_validation",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "final_validation",
									"documentation": "Worker выполняет итоговую проверку геометрии, обязательных инвариантов и критических ограничений уже сформированного результата."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_metrics",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "metrics",
									"documentation": "Worker рассчитывает канонические итоговые метрики по валидированным слоям; значения и единицы записываются в структуру результата."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_GenerationExecution_Node_manifest",
									"_parent": {
										"$ref": "ALG2_GenerationExecution_Partition_worker"
									},
									"name": "persist_manifest",
									"documentation": "Worker сохраняет manifest с версиями входов, seed, параметрами, перечнем артефактов и метрик; ссылки на файлы становятся частью воспроизводимого результата."
								}
							]
						}
					],
