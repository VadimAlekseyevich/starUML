					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioValidation_Partition_system",
							"_parent": {
								"$ref": "ALG2_ScenarioValidation_Activity"
							},
							"name": "Система",
							"documentation": "Роль «Система» выполняет логические действия этой дорожки.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioValidation_Node_snapshot",
									"_parent": {
										"$ref": "ALG2_ScenarioValidation_Partition_system"
									},
									"name": "Зафиксировать проверяемую версию",
									"documentation": "Система читает конфигурацию, режим, seed и версии связанных геоданных в единый validation context, чтобы результат относился к определённому набору входов."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioValidation_Node_required",
									"_parent": {
										"$ref": "ALG2_ScenarioValidation_Partition_system"
									},
									"name": "Проверить обязательные параметры",
									"documentation": "Система проверяет наличие обязательных полей и допустимость типов/диапазонов значений параметров застройки и инфраструктуры."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioValidation_Node_mode",
									"_parent": {
										"$ref": "ALG2_ScenarioValidation_Partition_system"
									},
									"name": "Проверить правила выбранного режима",
									"documentation": "Система проверяет режимные инварианты: для расширения требуется исходная территория; для генерации с нуля не должны использоваться несовместимые ссылки."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioValidation_Node_result",
									"_parent": {
										"$ref": "ALG2_ScenarioValidation_Partition_system"
									},
									"name": "Сформировать результат валидации",
									"documentation": "Система объединяет найденные ошибки и предупреждения в ValidationResult с кодами, полями/данными-источниками и признаком возможности запуска."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioValidation_Partition_data",
