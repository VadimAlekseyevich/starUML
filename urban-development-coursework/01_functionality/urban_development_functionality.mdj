									"_id": "ALG2_DatasetImport_Node_selectSource",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_user"
									},
									"name": "Выбрать файл или источник",
									"documentation": "Пользователь выбирает локальный файл либо настроенный источник; система получает URI/путь и не копирует данные до проверки формата."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_DatasetImport_Partition_system",
							"_parent": {
								"$ref": "ALG2_DatasetImport_Activity"
							},
