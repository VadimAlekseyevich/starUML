									"documentation": "Пользователь подтверждает, что именно показанная версия конфигурации должна быть запущена. Отказ не создаёт задачу и не меняет состояние сценария."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_ScenarioLaunch_Partition_system",
							"_parent": {
								"$ref": "ALG2_ScenarioLaunch_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "ALG2_ScenarioLaunch_Node_validate",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Повторно проверить конфигурацию и данные",
									"documentation": "Повторный синхронный вызов ScenarioValidation непосредственно перед запуском. Проверка выполняется по актуальным версиям конфигурации и исходных данных, а не по старому результату валидации.",
									"behavior": {
										"$ref": "ALG2_ScenarioValidation_Activity"
									},
									"isSynchronous": true
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_invalid",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Запретить запуск и показать ошибки",
									"documentation": "Система запрещает создание фоновой задачи, показывает ошибки повторной валидации и предлагает вернуться к настройке сценария."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_cancel",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Отменить операцию без создания задачи",
									"documentation": "Система закрывает подтверждение без создания Run/Job. Состояние проекта и конфигурации остаётся прежним."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_job",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Создать фоновую задачу",
									"documentation": "Система создаёт Run с неизменяемым snapshot конфигурации, присваивает идентификатор, начальное состояние Queued и помещает задание в очередь Worker."
								},
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "ALG2_ScenarioLaunch_Node_execute",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Выполнить генерацию сценария",
									"documentation": "Синхронный вызов детальной деятельности GenerationExecution. Вызов передаёт зафиксированный snapshot конфигурации/данных и возвращает итоговое состояние completed, failed либо cancelled.",
									"behavior": {
										"$ref": "ALG2_GenerationExecution_Activity"
									},
									"isSynchronous": true
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_complete",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Завершить сценарий и опубликовать результаты",
									"documentation": "Система фиксирует Completed, сохраняет ссылки на manifest/артефакты/метрики и делает результат доступным для сравнения и экспорта."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_failed",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Сохранить диагностику ошибки",
									"documentation": "Система фиксирует Failed, сохраняет код/этап/сообщение ошибки и техническую диагностику; частичный результат не публикуется как завершённый."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_ScenarioLaunch_Node_cancelled",
									"_parent": {
										"$ref": "ALG2_ScenarioLaunch_Partition_system"
									},
									"name": "Зафиксировать отменённое состояние",
									"documentation": "Система фиксирует Cancelled после безопасной остановки Worker и сохраняет диагностическую информацию о последнем завершённом этапе."
								}
							]
						}
					],
