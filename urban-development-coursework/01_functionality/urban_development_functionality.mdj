							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_probe",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Определить формат и метаданные",
									"documentation": "Система читает только необходимую часть источника, определяет драйвер/формат, CRS, пространственный охват, типы геометрии и доступные слои."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_unsupported",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Показать ошибку формата",
									"documentation": "Система сообщает распознанный/нераспознанный формат и перечень поддерживаемых вариантов; реестр проекта не изменяется."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_normalize",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Прочитать и нормализовать данные",
									"documentation": "Система читает слои, нормализует имена/типы атрибутов и подготавливает геометрию к хранению без изменения исходного файла."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_basicCheck",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Выполнить базовую проверку геометрии",
									"documentation": "Система отбрасывает явно нечитаемые объекты, фиксирует предупреждения и проверяет, что набор можно зарегистрировать; полная проверка качества выполняется отдельно."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_persist",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Сохранить набор и метаданные",
									"documentation": "Система атомарно сохраняет внутренний идентификатор набора, ссылку/копию источника, CRS, extent, состав слоёв и статус первоначальной проверки."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DatasetImport_Node_refresh",
									"_parent": {
										"$ref": "ALG2_DatasetImport_Partition_system"
									},
									"name": "Обновить реестр наборов",
									"documentation": "Система добавляет новый набор в список проекта и делает его доступным для просмотра, контроля качества и настройки интерпретации."
								}
							]
						}
