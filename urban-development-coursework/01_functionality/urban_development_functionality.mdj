							"_type": "UMLActivityPartition",
							"_id": "ALG2_DataManagement_Partition_user",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Пользователь / ГИС-аналитик",
							"documentation": "Swimlane «Пользователь / ГИС-аналитик»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_open",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_user"
									},
									"name": "Открыть исходные геоданные",
									"documentation": "Пользователь открывает раздел исходных геоданных текущего проекта. Система использует идентификатор проекта как контекст всех последующих операций."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_choose",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_user"
									},
									"name": "Выбрать операцию с геоданными",
									"documentation": "Пользователь выбирает одну логическую операцию: импорт, просмотр, проверку качества, настройку интерпретации или удаление набора."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_interpret",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_user"
									},
									"name": "Задать роль слоя и правила преобразования",
									"documentation": "ГИС-аналитик назначает семантическую роль слоя и правила преобразования атрибутов; система проверяет ссылочную целостность правил и сохраняет конфигурацию интерпретации."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "ALG2_DataManagement_Partition_system",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Система",
							"documentation": "Swimlane «Система»: действия, выполняемые этой ролью.",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_show",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Показать текущие наборы данных",
									"documentation": "Система читает реестр наборов данных и показывает имя, источник, тип, CRS, статус пригодности и время последней проверки; при наличии ошибок показывается индикатор диагностики."
								},
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "ALG2_DataManagement_Node_import",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Импортировать набор геоданных",
									"documentation": "Вызов отдельной деятельности DatasetImport. Она детализирует чтение источника, распознавание формата, извлечение метаданных, сохранение набора и обработку неподдерживаемого формата.",
									"behavior": {
										"$ref": "ALG2_DatasetImport_Activity"
									},
									"isSynchronous": true
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_view",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Показать слои и свойства",
									"documentation": "Система отображает свойства выбранного набора, состав слоёв, пространственный охват и доступный предварительный просмотр без изменения данных."
								},
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "ALG2_DataManagement_Node_quality",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Проверить CRS, геометрии и свойства",
									"documentation": "Вызов отдельной деятельности DataQualityValidation. Она детализирует проверки CRS, геометрии, обязательных свойств и формирование отчёта качества.",
									"behavior": {
										"$ref": "ALG2_DataQualityValidation_Activity"
									},
									"isSynchronous": true
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_delete",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Проверить зависимости и удалить набор",
									"documentation": "Система ищет зависимости набора в конфигурациях и запусках. При безопасном удалении запрашивается подтверждение; при активных зависимостях операция блокируется с перечнем зависимых объектов."
								},
								{
									"_type": "UMLAction",
									"_id": "ALG2_DataManagement_Node_update",
									"_parent": {
										"$ref": "ALG2_DataManagement_Partition_system"
									},
									"name": "Обновить состояние проекта",
									"documentation": "Система перечитывает реестр геоданных, обновляет статусы/счётчики в интерфейсе и помечает проект изменённым только если операция действительно изменила данные."
								}
							]
						}
					],
