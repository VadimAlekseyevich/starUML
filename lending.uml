</XPD:OBJ>
<XPD:OBJ name="OwnedElements[44]" type="UMLUseCase" guid="AAHpY9yDMUCV63F1dSpZnQAA">
<XPD:ATTR name="Name" type="string">Просмотр каталога кредитных продуктов</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Актор может просматривать список всех кредитных продуктов, найти конкретный кредитный продукт, просматривать информацию о нем.</XPD:ATTR>
