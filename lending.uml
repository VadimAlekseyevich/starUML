<XPD:OBJ name="OwnedElements[36]" type="UMLUseCase" guid="a6hJj0S/qkmCUp668DCVdQAA">
<XPD:ATTR name="Name" type="string">Добавление нового кредитного продукта</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Актор вводит данные нового кредитного продукта, включая название, процентную ставку, минимальную и максимальную сумму кредитования, а также условия погашения. Система проверяет введенные параметры и добавляет новый продукт в каталог доступных кредитов.</XPD:ATTR>
<XPD:REF name="Namespace">sT475ytsEEimqdQiO++/UQAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">4</XPD:ATTR>
