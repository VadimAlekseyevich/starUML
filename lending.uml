<XPD:OBJ name="OwnedElements[1]" type="UMLUseCase" guid="Nq1SRj+lRUGzscIa73lkOwAA">
<XPD:ATTR name="Name" type="string">Предоставить выписку по кредиту</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">По запросу клиента менеджер извлекает сведения о начислениях и платежах из журналов/Excel, формирует выписку за нужный период и выдает распечатку клиенту для информирования о состоянии кредита и остатке задолженности.</XPD:ATTR>
<XPD:REF name="Namespace">KA74ddIBqU6kAea3IBjPFAAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">4</XPD:ATTR>
