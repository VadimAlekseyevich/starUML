<XPD:OBJ name="OwnedElements[32]" type="UMLUseCase" guid="PYmIImjWD0CFwK6kEQP/YAAA">
<XPD:ATTR name="Name" type="string">Узнать информацию о клиенте</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Актор выбирает клиента из списка или вводит идентификатор клиента. Система отображает полную информацию о клиенте, включая личные данные, историю взаимодействий и текущие кредитные обязательства.</XPD:ATTR>
<XPD:REF name="Namespace">sT475ytsEEimqdQiO++/UQAA</XPD:REF>
