<XPD:OBJ name="OwnedElements[0]" type="UMLUseCase" guid="mQ9mZHWhCUixQ74jntihtAAA">
<XPD:ATTR name="Name" type="string">Получить консультацию по кредитным продуктам</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Клиент по телефону через оператора колл-центра  получает первичную консультацию о доступных кредитных продуктах: условия, ставки, требования, перечень необходимых документов. Консультация направлена на выбор подходящего продукта и подготовку клиента к подаче заявки.</XPD:ATTR>
<XPD:ATTR name="Attachments" type="string">C:\Users\lizaa\Desktop\radick\4 kurs\7 semac\ПрИС\Курсач\потоки\Сценарий использования Получить консультацию по кредитным продуктам.docx
</XPD:ATTR>
<XPD:REF name="Namespace">KA74ddIBqU6kAea3IBjPFAAA</XPD:REF>
