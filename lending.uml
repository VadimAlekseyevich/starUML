<XPD:OBJ name="OwnedElements[24]" type="UMLUseCase" guid="cC0wBB0M+UqRKL3zlfDdDAAA">
<XPD:ATTR name="Name" type="string">Досрочное погашение</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Актор принимает решение погасить кредит полностью или частично до истечения срока его действия. Система пересчитывает остаток задолженности, учитывая досрочный платеж. Досрочное погашение может привести к уменьшению общей суммы переплаты по кредиту.</XPD:ATTR>
<XPD:REF name="Namespace">sT475ytsEEimqdQiO++/UQAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">4</XPD:ATTR>
