<XPD:OBJ name="OwnedElements[3]" type="UMLUseCase" guid="ON8Jc6migk6JSj6WCjsYbwAA">
<XPD:ATTR name="Name" type="string">Выдать кредитные средства</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Менеджер оформляет распоряжение на выдачу средств, печатает ордер/квитанцию, а факт выдачи фиксируется в журнале/Excel.</XPD:ATTR>
<XPD:REF name="Namespace">KA74ddIBqU6kAea3IBjPFAAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">4</XPD:ATTR>
