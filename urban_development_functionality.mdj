                  "_parent": {
                    "$ref": "LG26_Project_Lane_0"
                  },
                  "name": "Ввести название и границы территории",
                  "documentation": "Пользователь указывает название проекта и область моделирования."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_correctBounds",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_0"
                  },
                  "name": "Исправить границы территории",
                  "documentation": "Пользователь корректирует границы и повторно запускает проверку."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_selectCrs",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_0"
                  },
                  "name": "Выбрать рабочую CRS",
                  "documentation": "Пользователь выбирает поддерживаемую систему координат."
                }
              ]
            },
            {
              "_type": "UMLActivityPartition",
              "_id": "LG26_Project_Lane_1",
              "_parent": {
                "$ref": "LG26_Project_Activity"
              },
              "name": "Система",
              "documentation": "Раздел ответственности «Система».",
              "nodes": [
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_form",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Показать форму нового проекта",
                  "documentation": "Система открывает поля названия, границ территории и рабочей CRS."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_check",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Проверить геометрию территории",
                  "documentation": "Проверяются замкнутость, корректность и допустимость геометрии выбранной территории."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_boundsError",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Показать ошибки границ",
                  "documentation": "Сообщение содержит причину отклонения введённой геометрии."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_proposeCrs",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Предложить систему координат",
                  "documentation": "Система предлагает подходящую проекцию для области моделирования."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_verifyCrs",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Проверить совместимость CRS",
                  "documentation": "Проверяется допустимость выбранной системы координат для проекта."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_crsError",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Показать ошибку CRS",
                  "documentation": "Выбор текущей системы координат не может быть принят."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_save",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Сохранить проект",
                  "documentation": "Создаются запись проекта и параметры его пространственной области."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Project_N_workspace",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
                  "name": "Открыть рабочее пространство",
                  "documentation": "Система отображает созданный проект."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG27_Project_Node_uniq",
                  "_parent": {
                    "$ref": "LG26_Project_Lane_1"
                  },
