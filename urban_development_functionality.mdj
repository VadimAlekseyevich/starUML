					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "COURSE_DataManagement_Lane_user",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "ГИС-аналитик",
							"documentation": "Раздел активности «ГИС-аналитик».",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_select",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_user"
									},
									"name": "Выбрать источник геоданных",
									"documentation": "ГИС-аналитик выбирает файл или поддерживаемый источник пространственных данных для текущего проекта."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_fix",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_user"
									},
									"name": "Исправить источник или настройки импорта",
									"documentation": "ГИС-аналитик исправляет исходный файл либо параметры импорта и повторяет подготовку набора."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_preview",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_user"
									},
									"name": "Просмотреть подготовленный слой",
									"documentation": "ГИС-аналитик просматривает импортированный слой и убеждается, что он корректно отображается в контексте проекта."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "COURSE_DataManagement_Lane_system",
							"_parent": {
								"$ref": "ALG2_DataManagement_Activity"
							},
							"name": "Система",
							"documentation": "Раздел активности «Система».",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_probe",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Определить формат и метаданные",
									"documentation": "Система определяет формат, тип геометрии, исходную систему координат и доступные метаданные."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_unsupported",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Показать неподдерживаемый формат",
									"documentation": "Если формат не поддерживается, система объясняет причину и перечисляет допустимые варианты."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_normalize",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Привести данные к рабочей системе координат",
									"documentation": "Система считывает пространственные данные и приводит их к рабочей метрической системе координат проекта."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_geometry",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Проверить геометрию",
									"documentation": "Система проверяет корректность геометрий, самопересечения и пригодность объектов для пространственных операций."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_attributes",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Проверить атрибуты и пространственный охват",
									"documentation": "Система проверяет обязательные атрибуты, согласованность метаданных и соответствие пространственного охвата территории проекта."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_report",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Показать отчёт о найденных ошибках",
									"documentation": "При критических ошибках система показывает конкретные проблемы, которые препятствуют использованию набора."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_DataManagement_Action_persist",
									"_parent": {
										"$ref": "COURSE_DataManagement_Lane_system"
									},
									"name": "Сохранить подготовленный набор",
									"documentation": "После успешной проверки система регистрирует набор данных и делает его доступным для сценариев моделирования."
								}
							]
						}
					],
