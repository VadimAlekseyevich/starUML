                  "name": "Показать геослои проекта",
                  "documentation": "Система выводит импортированные наборы и их состояние."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_apply",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Выполнить операцию и обновить список",
                  "documentation": "Показать свойства слоя, сохранить его интерпретацию или удалить набор после проверки зависимостей."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_parse",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Определить формат и метаданные",
                  "documentation": "Система считывает формат, поля, геометрию и пространственную привязку."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_normalize",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Привести данные к рабочей CRS",
                  "documentation": "Извлечение геометрии и согласование системы координат с проектом."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_quality",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Проверить геометрию объектов",
                  "documentation": "Система проверяет геометрические ошибки объектов и топологическую пригодность слоя."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_persist",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Сохранить набор и метаданные",
                  "documentation": "Регистрируются корректные данные, происхождение, CRS и назначение слоя."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG26_Data_N_result",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Обновить список и статус геоданных",
                  "documentation": "Система показывает результат импорта либо другой выполненной операции."
                },
                {
                  "_type": "UMLAction",
                  "_id": "LG27_Data_Node_attrs",
                  "_parent": {
                    "$ref": "LG26_Data_Lane_1"
                  },
                  "name": "Проверить обязательные атрибуты",
                  "documentation": "Система выявляет отсутствие обязательных атрибутов, недопустимые значения и несовместимые типы полей."
                }
              ]
            }
