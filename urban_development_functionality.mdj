							"name": "Система",
							"documentation": "Раздел активности «Система».",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_prepare",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Подготовить исходную территорию и данные",
									"documentation": "Система формирует рабочее представление территории и выбранных исходных наборов для текущего сценария."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_constraints",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Проверить пространственные ограничения",
									"documentation": "Система выявляет ограничения, которые должны учитываться при развитии территории."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_suitability",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Оценить пригодность территории",
									"documentation": "Система рассчитывает пригодность территории к освоению по исходным пространственным данным."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_earlyFail",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Остановить генерацию из-за критических ограничений",
									"documentation": "При критическом исходном ограничении система прекращает построение варианта и сохраняет причину."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_zoning",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Сформировать функциональное зонирование",
