									"_id": "LG26_Project_N_workspace",
									"_parent": {
										"$ref": "LG26_Project_Lane_1"
									},
									"name": "Открыть рабочее пространство",
									"documentation": "Система отображает созданный проект."
								},
								{
									"_type": "UMLAction",
									"_id": "LG27_Project_Node_uniq",
									"_parent": {
										"$ref": "LG26_Project_Lane_1"
									},
									"name": "Проверить уникальность названия",
									"documentation": "Система проверяет уникальность введённого названия среди существующих проектов."
								},
								{
									"_type": "UMLAction",
									"_id": "LG26_Project_N_form",
									"_parent": {
										"$ref": "LG26_Project_Lane_1"
									},
									"name": "Отображать форму нового проекта",
									"documentation": "Система поддерживает форму с полями названия, границ территории и CRS открытой во время всех действий пользователя, проверок и повторных исправлений. Ветка завершается только после получения корректных параметров и подтверждения ввода, непосредственно перед сохранением проекта."
								}
							]
						}
