							},
							"name": "Пользователь",
							"documentation": "Раздел активности «Пользователь».",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_select",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_user"
									},
									"name": "Выбрать настроенный сценарий",
									"documentation": "Пользователь выбирает сохранённую конфигурацию сценария для выполнения."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_summary",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_user"
									},
									"name": "Просмотреть параметры перед запуском",
									"documentation": "Пользователь просматривает режим, seed, территорию и основные параметры подготовленного сценария."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_confirm",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_user"
									},
									"name": "Подтвердить запуск",
									"documentation": "Пользователь подтверждает выполнение сценария либо отказывается от запуска."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "COURSE_ScenarioLaunch_Lane_system",
							"_parent": {
								"$ref": "ALG2_ScenarioLaunch_Activity"
							},
							"name": "Система",
							"documentation": "Раздел активности «Система».",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_validate",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Проверить конфигурацию и исходные данные",
									"documentation": "Система повторно проверяет конфигурацию и готовность связанных геоданных непосредственно перед запуском."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_invalid",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Показать ошибки и запретить запуск",
									"documentation": "Если обязательные проверки не пройдены, система показывает причины и не создаёт запуск."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_create",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Создать запуск сценария",
									"documentation": "Система создаёт новый запуск и фиксирует выбранную конфигурацию и исходные данные."
								},
								{
									"_type": "UMLCallBehaviorAction",
									"_id": "COURSE_ScenarioLaunch_Action_execute",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Выполнить генерацию сценария",
									"documentation": "Вызывается детальный предметный алгоритм генерации сценария.",
									"behavior": {
										"$ref": "ALG2_GenerationExecution_Activity"
									}
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_success",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Показать готовый результат",
									"documentation": "При успешном завершении система делает итоговые слои и показатели доступными для просмотра."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_error",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Показать диагностику ошибки",
									"documentation": "При ошибке система показывает этап и причину, по которой сценарий не был завершён."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_ScenarioLaunch_Action_stopped",
									"_parent": {
										"$ref": "COURSE_ScenarioLaunch_Lane_system"
									},
									"name": "Показать остановленное выполнение",
									"documentation": "Если выполнение было остановлено пользователем, система фиксирует остановку и не выдаёт незавершённый результат как готовый."
								}
							]
						}
