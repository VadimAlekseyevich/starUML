								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_roads",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Сформировать или расширить дорожную сеть",
									"documentation": "Система формирует новую либо расширяет существующую дорожную сеть с учётом выбранного режима."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_blocks",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Выделить кварталы и участки",
									"documentation": "По дорожной и пространственной структуре выделяются кварталы и участки для размещения объектов."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_buildings",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Разместить здания",
									"documentation": "Система размещает здания в допустимых участках согласно параметрам застройки и ограничениям."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_demography",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Рассчитать население и потребности",
									"documentation": "По сформированной застройке рассчитываются население и спрос на инфраструктурные объекты."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_infrastructure",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Разместить инфраструктуру",
									"documentation": "Система размещает инфраструктурные объекты с учётом рассчитанного спроса и пространственной доступности."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_finalValidation",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Проверить итоговый вариант",
									"documentation": "Система выполняет итоговую проверку пространственных и предметных ограничений сформированного варианта."
								},
								{
									"_type": "UMLAction",
									"_id": "COURSE_GenerationExecution_Action_metrics",
									"_parent": {
										"$ref": "COURSE_GenerationExecution_Lane_system"
									},
									"name": "Рассчитать итоговые показатели",
